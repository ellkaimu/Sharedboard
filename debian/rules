#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYBUILD_NAME = shareboard
export PYBUILD_DISABLE_python2 = 1
export PYBUILD_SYSTEM = pybuild
export PYBUILD_PLUGIN_PYPROJECT = 1

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Install launcher script (the [project.scripts] entry-point is also
	# generated by pybuild; this gives us a fixed path at /usr/bin/shareboard
	# regardless of how entry-points get resolved).
	install -D -m 0755 debian/shareboard.sh debian/shareboard/usr/bin/shareboard

override_dh_installsystemd:
	dh_installsystemd --name=shareboard

override_dh_auto_test:
	# Tests aren't packaged in the .deb.
	@true

# Hardening: keep systemd unit, desktop file, icon.
install -D -m 0644 shareboard.service debian/shareboard/lib/systemd/system/shareboard.service
install -D -m 0644 shareboard.desktop debian/shareboard/usr/share/applications/shareboard.desktop
