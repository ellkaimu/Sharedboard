#!/usr/bin/make -f

export DH_VERBOSE = 1
export PYBUILD_NAME = shareboard

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_install:
	dh_auto_install
	# Fixed-path launcher at /usr/bin/shareboard (overwrites the
	# [project.scripts] entry point pybuild generated at the same path).
	install -D -m 0755 debian/shareboard.sh debian/shareboard/usr/bin/shareboard
	install -D -m 0644 shareboard.service debian/shareboard/lib/systemd/system/shareboard.service
	install -D -m 0644 shareboard.desktop debian/shareboard/usr/share/applications/shareboard.desktop

override_dh_auto_test:
	# Tests run in the separate pytest CI job, not during the .deb build.
	@true
